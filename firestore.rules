rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection ping check for verifying real Firestore connectivity on boot
    match /test/{docId} {
      allow read: if true;
    }

    // User preferences collection: Strictly private to authenticated user
    match /users/{userId}/preferences/{prefId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create, update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && incoming().userId == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }

    // Farmer advisory records collection: Strictly private to authenticated user
    match /users/{userId}/advisories/{advisoryId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && isValidId(advisoryId)
        && incoming().userId == userId;
      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && incoming().userId == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }
  }
}
